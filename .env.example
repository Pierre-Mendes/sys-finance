# Configurações de Banco de Dados (Produção)
DB_ROOT_PASSWORD=alterar_por_favor
DB_NAME=money_manager
DB_USER=manager_user
DB_PASS=senha_forte_aqui

# Configurações de Frontend (Produção)
# IMPORTANTE: Esta URL é usada durante o build para que o Vue saiba onde a API está.
VITE_API_BASE_URL=http://SEU_IP_DO_VPS_OU_DOMINIO

# Segurança da API
# Chave para assinar os tokens JWT. OPCIONAL: se vazia, a aplicação gera uma no primeiro uso
# e guarda no banco (tabela app_secrets), mantendo-a entre deploys.
# Defina só se quiser controlar/rotacionar a chave (mín. 32 caracteres; ex.: openssl rand -base64 48).
# Atenção: trocar a chave desloga todos os usuários.
JWT_SECRET=
# Validade do token em segundos (padrão: 7 dias)
JWT_TTL=604800
# Origens autorizadas a chamar a API (separadas por vírgula). Vazio = "*" (compatível com o comportamento antigo).
CORS_ALLOWED_ORIGINS=
# Origens extras liberadas no CSP para fetch/XHR da SPA (ex.: API em outro host, Sentry)
CSP_CONNECT_SRC=https://*.sentry.io
