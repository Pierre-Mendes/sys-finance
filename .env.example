# Configurações de Banco de Dados (Produção)
DB_ROOT_PASSWORD=alterar_por_favor
DB_NAME=money_manager
DB_USER=manager_user
DB_PASS=senha_forte_aqui

# Configurações de Frontend (Produção)
# IMPORTANTE: Esta URL é usada durante o build para que o Vue saiba onde a API está.
VITE_API_BASE_URL=http://SEU_IP_DO_VPS_OU_DOMINIO

# Segurança da API
# Chave para assinar os tokens JWT. OPCIONAL: se vazia, a aplicação gera uma no primeiro uso
# e guarda no banco (tabela app_secrets), mantendo-a entre deploys.
# Defina só se quiser controlar/rotacionar a chave (mín. 32 caracteres; ex.: openssl rand -base64 48).
# Atenção: trocar a chave desloga todos os usuários.
JWT_SECRET=
# Validade do token em segundos (padrão: 7 dias)
JWT_TTL=604800
# Origens autorizadas a chamar a API (separadas por vírgula). Vazio = "*" (compatível com o comportamento antigo).
CORS_ALLOWED_ORIGINS=
# Origens extras liberadas no CSP para fetch/XHR da SPA (ex.: API em outro host, Sentry)
CSP_CONNECT_SRC=https://*.sentry.io

# --- Monitoramento de erros (Sentry ou GlitchTip self-hosted) — passo a passo em docs/guides/monitoring.md ---
# Erros da API (PHP). Com o GlitchTip no Docker use o host interno: http://<chave>@glitchtip:8000/<id-do-projeto>
SENTRY_DSN=
# Erros do navegador (Vue). Use um segundo projeto; também pode ser o host interno (o envio passa pelo túnel da API).
SENTRY_FRONTEND_DSN=
# GlitchTip (docker-compose.monitoring.yml). Preencher GLITCHTIP_SECRET_KEY faz o deploy subir o GlitchTip junto.
GLITCHTIP_SECRET_KEY=
GLITCHTIP_DB_PASSWORD=troque_esta_senha
GLITCHTIP_DOMAIN=http://localhost:8000
# Alertas por e-mail (opcional), ex.: smtp://usuario:senha-de-app@smtp.gmail.com:587
GLITCHTIP_EMAIL_URL=

# --- Bot do Telegram (docs/guides/telegram.md) ---
# Token e usuário (sem @) do bot criado no @BotFather. Vazios = bot desligado.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# URL pública HTTPS do sistema (o Telegram só entrega mensagens em HTTPS)
APP_URL=https://financas.seudominio.com.br
