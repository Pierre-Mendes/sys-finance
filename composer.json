{
    "name": "gerenciador/financeiro",
    "description": "Gerenciador Financeiro Pessoal API",
    "type": "project",
    "require": {
        "php": "^8.4",
        "slim/slim": "4.*",
        "slim/psr7": "^1.6",
        "dompdf/dompdf": "^3.1",
        "robmorgan/phinx": "^0.14.0",
        "guzzlehttp/guzzle": "^7.10"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "mockery/mockery": "^1.6",
        "php-vcr/php-vcr": "^1.8"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    }
}
