    "capi": { "100": "#FDE7C4", "500": "#F2A541", "700": "#C97C12" },
    "ink": { "50": "#F6F7F9", "100": "#EEF1F5", "200": "#C5CCD6", "500": "#5B6B85", "700": "#26324A", "800": "#141E33", "900": "#0B1324" },
    "semantic": {
